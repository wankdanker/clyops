{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wankdanker/clyops/spec/schema.json",
  "title": "clyops --help-json-schema output",
  "description": "Describes a clyops program's interface (spec/SPEC.md section 8). Consumers such as apps/runner build forms from it.",
  "type": "object",
  "required": ["clyops", "script", "description", "epilog", "arguments", "options", "requiredCommands"],
  "additionalProperties": false,
  "properties": {
    "clyops": { "const": 1, "description": "Format version." },
    "script": { "type": "string", "description": "Program name shown in usage." },
    "description": { "type": "string" },
    "epilog": { "type": "string" },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "required", "isVariadic", "default", "validation"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "required": { "type": "boolean", "description": "True when the argument has no default and is not variadic." },
          "isVariadic": { "type": "boolean", "description": "Collects every remaining positional token; only the last argument." },
          "default": { "type": "string" },
          "validation": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "shortName", "variableName", "description", "default", "group", "type", "isFlag", "isArray", "required", "validation", "choices"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Long name without --." },
          "shortName": { "type": "string", "maxLength": 1, "description": "Single character without -, or empty." },
          "variableName": { "type": "string", "minLength": 1, "description": "Value key and environment variable name." },
          "description": { "type": "string" },
          "default": { "type": "string", "description": "\"false\" for flags, \"\" when there is none." },
          "group": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "integer", "number", "boolean", "choice", "path"] },
          "isFlag": { "type": "boolean" },
          "isArray": { "type": "boolean" },
          "required": { "type": "boolean" },
          "validation": { "$ref": "#/$defs/rule" },
          "choices": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requiredCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "description", "installHint"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "installHint": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "description": "Validation rule (spec/SPEC.md section 5), or empty.",
      "type": "string",
      "pattern": "^(|int|float|string|path|ip|hostname|url|port|email|uuid|bool|date:YYYY-MM-DD|file:(exists|readable|writable)|dir:(exists|writable)|int:([0-9]+-[0-9]*|-[0-9]+)|float:([0-9]*\\.?[0-9]+-([0-9]*\\.?[0-9]+)?|-[0-9]*\\.?[0-9]+)|string:([0-9]+|[0-9]+-[0-9]*|-[0-9]+)|choice:.+|regex:.+)$"
    }
  }
}
