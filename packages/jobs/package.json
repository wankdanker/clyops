{
  "name": "clyops-jobs",
  "version": "0.1.0",
  "description": "Run clyops tools as jobs: config-bound functions, templated invocation, artifacts, job records and a queue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wankdanker/clyops.git",
    "directory": "packages/jobs"
  },
  "keywords": [
    "clyops",
    "jobs",
    "queue",
    "cli",
    "tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "clyops-tools": "0.1.0"
  }
}
