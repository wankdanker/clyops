{
  "name": "clyops-tools",
  "version": "0.2.0",
  "description": "Discover, describe and run a directory of clyops tools from Node: schemas, JSON input to argv, JSON Schema.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/wankdanker/clyops.git", "directory": "packages/tools" },
  "keywords": ["clyops", "cli", "tools", "json-schema", "dispatcher"],
  "engines": { "node": ">=20" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./clyops-tools.cjs" } },
  "files": ["dist", "src", "clyops-tools.cjs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
