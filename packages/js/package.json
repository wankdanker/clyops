{
  "name": "clyops",
  "version": "0.2.0",
  "description": "Declarative one-line-per-option CLI parsing: validation, help text, JSON schema, config files and completion.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/wankdanker/clyops.git", "directory": "packages/js" },
  "keywords": ["cli", "argv", "options", "parser", "argparse", "help", "completion"],
  "engines": { "node": ">=20" },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist/cjs", "dist/esm", "dist/types", "src", "clyops.cjs"],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/mark-dist.mjs && tsc -p tsconfig.examples.json",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
