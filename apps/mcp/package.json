{
  "name": "clyops-mcp",
  "version": "0.1.0",
  "description": "Give an AI agent a directory of clyops tools over MCP (stdio or streamable HTTP), with each tool's input schema from its --help-json-schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wankdanker/clyops.git",
    "directory": "apps/mcp"
  },
  "keywords": [
    "clyops",
    "mcp",
    "model-context-protocol",
    "agent",
    "cli",
    "tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "clyops-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clyops": "0.1.0",
    "clyops-tools": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "express": "^5.2.1"
  }
}
