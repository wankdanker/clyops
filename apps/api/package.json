{
  "name": "clyops-api",
  "version": "0.12.0",
  "description": "Serve a directory of clyops tools as an HTTP API: an endpoint per tool, validated and documented in OpenAPI from its schema, with sync and async (job) runs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wankdanker/clyops.git",
    "directory": "apps/api"
  },
  "keywords": [
    "clyops",
    "api",
    "openapi",
    "express",
    "cli",
    "tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "clyops-api": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../tools/test-leaks.mjs --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "ajv": "^8.20.0",
    "busboy": "^1.6.0",
    "clyops": "0.12.0",
    "clyops-jobs": "0.12.0",
    "clyops-mcp": "0.12.0",
    "clyops-tools": "0.12.0",
    "express": "^5.2.1",
    "plus-express": "^2.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "clyops-web": "0.12.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://clyops.io/node-tools.html"
}
