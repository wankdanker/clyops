{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clyops-runner",
  "version": "0.1.0",
  "identifier": "com.github.wankdanker.clyops.runner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "clyops",
    "copyright": "Copyright (c) 2026 Dan VerWeire",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Run clyops tools from generated forms",
    "longDescription": "A desktop UI that lists the clyops tools in a directory, builds a form for each from its --help-json-schema output, runs them and streams their output.",
    "homepage": "https://github.com/wankdanker/clyops",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "clyops runner",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
