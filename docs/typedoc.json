{
  "entryPoints": [
    "../packages/schema/src/index.ts",
    "../packages/js/src/index.ts",
    "../packages/tools/src/index.ts",
    "../packages/jobs/src/index.ts",
    "../apps/api/src/index.ts",
    "../apps/mcp/src/index.ts",
    "../apps/doc/src/index.ts"
  ],
  "tsconfig": "tsconfig.json",
  "name": "clyops Node API",
  "out": "_native/node",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notDocumented": true,
    "invalidLink": true
  },
  "requiredToBeDocumented": [
    "Class",
    "Interface",
    "Function",
    "Method",
    "Constructor",
    "Accessor",
    "TypeAlias",
    "Enum",
    "EnumMember",
    "Variable"
  ],
  "treatValidationWarningsAsErrors": true,
  "packagesRequiringDocumentation": [
    "clyops",
    "clyops-tools",
    "clyops-jobs",
    "clyops-api",
    "clyops-mcp",
    "clyops-schema"
  ]
}
